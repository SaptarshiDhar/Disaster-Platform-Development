# RAKSHA web app — local development configuration EXAMPLE.
#
# Copy this file to `.env.local` and adjust if your ports differ:
#
#     cp .env.local.example .env.local
#
# `.env.local` itself is gitignored and must never be committed.
# No secrets belong in this file: both engines are keyless, and every upstream
# data provider used by RAKSHA (Open-Meteo, Open Topo Data, MET Norway, USGS)
# is free and requires no API key.

# Python flood engine (services/flood-forecast-engine), default port 8010:
#   .venv\Scripts\python.exe -m uvicorn raksha_flood.api.main:app --port 8010
FLOOD_MODEL_API_URL=http://127.0.0.1:8010

# Python landslide engine (services/landslide-engine), default port 8020:
#   ..\flood-forecast-engine\.venv\Scripts\python.exe -m uvicorn raksha_landslide.api.main:app --port 8020
LANDSLIDE_MODEL_API_URL=http://127.0.0.1:8020

# Python cloudburst engine (services/cloudburst-engine), default port 8030.
# Rule-based alert engine, not a trained model — no artifact to load.
#   ..lood-forecast-engine\.venv\Scripts\python.exe -m uvicorn raksha_cloudburst.api.main:app --port 8030
CLOUDBURST_ENGINE_API_URL=http://127.0.0.1:8030

# Deliberately NOT prefixed with NEXT_PUBLIC_. The browser never calls the
# Python engines directly; every request goes through the Next.js server-side
# routes under src/app/api/*, so these URLs stay out of the client bundle.
