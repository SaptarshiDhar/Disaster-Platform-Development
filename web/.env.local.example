# RAKSHA web app — server-side environment configuration
# Copy to .env.local (never committed).
#
# Deliberately NOT prefixed with NEXT_PUBLIC_ — the browser never talks to
# the Python flood engine directly; every request goes through the Next.js
# server-side API routes in src/app/api/flood/*.

FLOOD_MODEL_API_URL=http://127.0.0.1:8000
