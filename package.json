{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./tools/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./apps/**\" --filter \"./scripts\" --if-present run typecheck",
    "web:dev": "pnpm --filter @workspace/web run dev",
    "web:build": "pnpm --filter @workspace/web run build",
    "web:lint": "pnpm --filter @workspace/web run lint",
    "web:typecheck": "pnpm --filter @workspace/web run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
