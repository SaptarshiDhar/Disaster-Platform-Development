# =========================================================
# RAKSHA — apps/web environment template
#
# Copy to `.env.local` (git-ignored) and fill in real values:
#     cp apps/web/.env.example apps/web/.env.local
#
# Phase 0 requires NONE of these. The landing page and
# /api/health build, deploy and run with this file empty.
# =========================================================

# ---------------------------------------------------------
# PUBLIC APPLICATION CONFIG
# ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown in the UI as an environment badge. One of:
#   development | preview | production
NEXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------
# SUPABASE — PUBLIC CLIENT CONFIGURATION
# Safe to expose to the browser. The anon key is protected by
# Row Level Security, which is why RLS is mandatory (Phase 2).
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------
# SUPABASE — SERVER ONLY
# NEVER prefix with NEXT_PUBLIC_. This key bypasses RLS.
# Only ever read from server-only modules (see src/lib/supabase/admin.ts).
# ---------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------
# MAP CONFIGURATION
# A MapLibre style JSON URL. Leave blank until an authorised
# basemap provider is chosen (see docs/architecture.md).
# ---------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=

# ---------------------------------------------------------
# EXTERNAL API CONFIGURATION
# ---------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
